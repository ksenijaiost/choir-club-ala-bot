# Telegram Bot API (from @BotFather)
BOT_TOKEN=

# Дирижёр — главный админ (Telegram user id)
CONDUCTOR_TELEGRAM_ID=

# Приватная группа для загрузки материалов (chat id, обычно отрицательный)
ADMIN_CHAT_ID=

# Для SQLite (локально): DB_CONNECTION=sqlite и путь к файлу
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=storage/choir.sqlite

# Часовой пояс (все cron-правила и «12:00» — в этом поясе)
TIMEZONE=Asia/Almaty

# Webhook: полный HTTPS URL до public/webhook.php на хостинге
WEBHOOK_URL=

# Webhook: секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Ключ для защиты простых HTTP-страниц админки/cron (если используется)
ADMIN_PAGES_KEY=

# Опционально: переопределение дней напоминаний об оплате (1–31)
# PAYMENT_REMINDER_DAY_1=23
# PAYMENT_REMINDER_DAY_2=1
# PAYMENT_REMINDER_HOUR=12

# Опционально: горизонт генерации репетиций (недель)
# SCHEDULE_GENERATION_WEEKS=4

# Опционально: длительность репетиции по умолчанию (минуты) для окна check-in
# REHEARSAL_DEFAULT_DURATION_MINUTES=120

# Локальное тестирование cron: подмена «сейчас» (ISO 8601, пояс TIMEZONE)
# FAKE_NOW=2026-11-22T12:00:00+05:00
