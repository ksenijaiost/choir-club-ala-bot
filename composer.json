{
    "name": "club-ala/choir-club-ala-bot",
    "description": "Telegram bot for Club Ala choir (@CHOIR_CLUB_ALA_bot)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "nutgram/nutgram": "^4.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
