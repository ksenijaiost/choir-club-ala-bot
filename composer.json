{
    "name": "club-ala/choir-club-ala-bot",
    "description": "Telegram bot for Club Ala choir (@CHOIR_CLUB_ALA_bot)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "nutgram/nutgram": "^4.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "autoload-check": "php bin/psr4-check.php",
        "test": [
            "@autoload-check",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
